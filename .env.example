# Name shown at the top of the site
SITE_NAME="School Charity Shop"

# The person in need. Only the last 4 digits of the card are shown on the site.
# Note: online payments are paid out to the bank account of the Payme/Click
# merchant (see README), so make sure that account forwards to this card.
RECIPIENT_NAME="Name of the person in need"
RECIPIENT_CARD="8600 0000 0000 0000"

# Admin page password (for the teacher who approves items and hands them over)
ADMIN_PASSWORD=change-me
# Any long random text; keeps admin logins valid across restarts
SESSION_SECRET=replace-with-a-long-random-string

# Public address of the site, used for payment return links
BASE_URL=http://localhost:3000
PORT=3000

# Which payments to offer: test, payme, click (comma separated).
# "test" is a fake payment page for trying the site. Remove it before going live!
PAYMENT_PROVIDERS=test

# Payme (https://business.payme.uz)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true

# Click (https://click.uz/en/business)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Minutes an unpaid order keeps an item reserved
RESERVE_MINUTES=30
