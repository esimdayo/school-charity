# Name shown at the top of the site
SITE_NAME="School Charity Shop"

# The person in need. Buyers transfer money to this card; the full number is
# shown only on the payment page, everywhere else just the last 4 digits.
RECIPIENT_NAME="Name of the person in need"
RECIPIENT_CARD="1111 1111 2222 2222"

# Admin page password (for the teacher who approves items and hands them over)
ADMIN_PASSWORD=change-me
# Any long random text; keeps admin logins valid across restarts
SESSION_SECRET=replace-with-a-long-random-string

# Public address of the site, used for payment return links
BASE_URL=http://localhost:3000
PORT=3000

# Which payments to offer: card, payme, click, test (comma separated).
# "card": buyers send money to RECIPIENT_CARD, a teacher confirms it on the admin page.
# "test" is a fake payment page for trying the site. Never use it on the live site!
PAYMENT_PROVIDERS=card

# Payme (https://business.payme.uz)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true

# Click (https://click.uz/en/business)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Minutes an unpaid order keeps an item reserved (before the buyer presses "I've sent the money")
RESERVE_MINUTES=30

# Telegram bot (optional): admins get a message for every card payment and can
# press "Money arrived" / "Not received" right in Telegram.
# 1. Create a bot with @BotFather and paste its token here.
# 2. Start the site, send any message to your bot: it replies with your ID.
# 3. Put the ID(s) here, comma separated, and restart the site.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Language of the bot messages: uz, ru or en
TELEGRAM_LANG=uz
